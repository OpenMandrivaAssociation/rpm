+/**
+ * Determine if PGO (Profile-Guided Optimization) should be used.
+ * Returns 1 if PGO is applicable, 0 otherwise.
+ */
+static int pgoBuildEnabled(rpmSpec spec, int what)
+{
+    /* Must have a %pgo section */
+    if (!rpmSpecGetSection(spec, RPMBUILD_PGO))
+	return 0;
+
+    /* --nopgo: skip the two-pass flow (same as noarch / cross-compile) */
+    if (what & RPMBUILD_NOPGO)
+	return 0;
+
+    /* Don't PGO noarch packages — no compiled binaries */
+    const char *arch = headerGetString(spec->packages->header, RPMTAG_ARCH);
+    if (arch && rstreq(arch, "noarch"))
+	return 0;
+
+    /* Don't PGO when we can't run the binaries (true cross-compile).
+     * Use rpmMachineScore on the package arch rather than comparing
+     * %{_build_cpu} with %{_target_cpu}: subarchitectures like znver1
+     * set the package/_target arch to "znver1" while _build_cpu stays at
+     * the generic "x86_64" from config.guess, which is not a real
+     * cross-compile. Score 0 means this host cannot run that arch.
+     * Likewise for a foreign OS (e.g. mingw32 on Linux). */
+    if (arch && rpmMachineScore(RPM_MACHTABLE_INSTARCH, arch) == 0)
+	return 0;
+    const char *os = headerGetString(spec->packages->header, RPMTAG_OS);
+    if (os && rpmMachineScore(RPM_MACHTABLE_INSTOS, os) == 0)
+	return 0;
+
+    return 1;
+}
+
+/**
+ * Detect whether %{__cc} is Clang.
+ *
+ * %{__cc} is typically /usr/bin/cc (or /usr/bin/c++), which may be a
+ * symlink or wrapper whose name does not contain "clang". Matching the
+ * command string for "clang" therefore treats Clang as GCC and injects
+ * GCC-only flags such as -fprofile-correction. Ask the compiler for
+ * predefined macros instead; __clang__ is authoritative and works for
+ * cc -> clang, ccache wrappers, and explicit "clang"/"gcc" names.
+ */
+static int pgoIsClang(void)
+{
+    static int cached = -1;
+    char *cmd;
+    FILE *fp;
+    char buf[512];
+    int is_clang = 0;
+
+    if (cached >= 0)
+	return cached;
+
+    cmd = rpmExpand("%{__cc} -dM -E -x c /dev/null 2>/dev/null", NULL);
+    fp = popen(cmd, "r");
+    if (fp != NULL) {
+	while (fgets(buf, sizeof(buf), fp) != NULL) {
+	    if (strstr(buf, "#define __clang__") != NULL) {
+		is_clang = 1;
+		break;
+	    }
+	}
+	(void) pclose(fp);
+    }
+    free(cmd);
+
+    cached = is_clang;
+    return is_clang;
+}
+
+/**
+ * Set environment variables to inject PGO instrumentation flags.
+ * Since spec section scripts are expanded at parse time, macro overrides
+ * alone don't work. Instead, we set CFLAGS/CXXFLAGS/LDFLAGS as env vars.
+ * The %set_build_flags macro uses ${CFLAGS:-%{build_cflags}}, so if CFLAGS
+ * is set in the process environment, the child shell will inherit it and
+ * the ${CFLAGS:-...} pattern will use the env var value.
+ */
+static void pgoPushGenerateEnv(rpmSpec spec)
+{
+    char *profdir = rpmExpand("%{_pgo_profile_dir}", NULL);
+
+    char *gen_cflags = NULL;
+    char *gen_ldflags = NULL;
+    /* -fprofile-update=atomic: safe counters when the training workload is
+     * multi-threaded (OpenMP, etc.). Both GCC and Clang accept it. */
+    rasprintf(&gen_cflags, "-fprofile-generate=%s -fprofile-update=atomic", profdir);
+    rasprintf(&gen_ldflags, "-fprofile-generate=%s", profdir);
+
+    char *orig_optflags = rpmExpand("%{optflags}", NULL);
+    char *orig_ldflags = rpmExpand("%{?build_ldflags}", NULL);
+
+    char *new_cflags = NULL;
+    char *new_ldflags = NULL;
+    rasprintf(&new_cflags, "%s %s", orig_optflags, gen_cflags);
+    if (orig_ldflags[0])
+	rasprintf(&new_ldflags, "%s %s", orig_ldflags, gen_ldflags);
+    else
+	rasprintf(&new_ldflags, "%s", gen_ldflags);
+
+    setenv("CFLAGS", new_cflags, 1);
+    setenv("CXXFLAGS", new_cflags, 1);
+    setenv("FFLAGS", new_cflags, 1);
+    setenv("FCFLAGS", new_cflags, 1);
+    setenv("LDFLAGS", new_ldflags, 1);
+    setenv("RPM_OPT_FLAGS", new_cflags, 1);
+
+    rpmlog(RPMLOG_NOTICE, _("PGO: CFLAGS=%s\n"), new_cflags);
+    rpmlog(RPMLOG_NOTICE, _("PGO: LDFLAGS=%s\n"), new_ldflags);
+
+    free(profdir);
+    free(gen_cflags);
+    free(gen_ldflags);
+    free(orig_optflags);
+    free(orig_ldflags);
+    free(new_cflags);
+    free(new_ldflags);
+}
+
+/**
+ * Set environment variables to inject PGO profile-use flags.
+ */
+static void pgoPushUseEnv(rpmSpec spec)
+{
+    char *profdir = rpmExpand("%{_pgo_profile_dir}", NULL);
+    int is_clang = pgoIsClang();
+
+    char *use_cflags = NULL;
+    char *use_ldflags = NULL;
+    if (is_clang) {
+	char *profdata = NULL;
+	rasprintf(&profdata, "%s/merged.profdata", profdir);
+	rasprintf(&use_cflags, "-fprofile-use=%s", profdata);
+	rasprintf(&use_ldflags, "-fprofile-use=%s", profdata);
+	free(profdata);
+    } else {
+	rasprintf(&use_cflags, "-fprofile-use=%s -fprofile-correction -Wno-missing-profile", profdir);
+	rasprintf(&use_ldflags, "-fprofile-use=%s", profdir);
+    }
+
+    char *orig_optflags = rpmExpand("%{optflags}", NULL);
+    char *orig_ldflags = rpmExpand("%{?build_ldflags}", NULL);
+
+    char *new_cflags = NULL;
+    char *new_ldflags = NULL;
+    rasprintf(&new_cflags, "%s %s", orig_optflags, use_cflags);
+    if (orig_ldflags[0])
+	rasprintf(&new_ldflags, "%s %s", orig_ldflags, use_ldflags);
+    else
+	rasprintf(&new_ldflags, "%s", use_ldflags);
+
+    setenv("CFLAGS", new_cflags, 1);
+    setenv("CXXFLAGS", new_cflags, 1);
+    setenv("FFLAGS", new_cflags, 1);
+    setenv("FCFLAGS", new_cflags, 1);
+    setenv("LDFLAGS", new_ldflags, 1);
+    setenv("RPM_OPT_FLAGS", new_cflags, 1);
+
+    rpmlog(RPMLOG_NOTICE, _("PGO: CFLAGS=%s\n"), new_cflags);
+    rpmlog(RPMLOG_NOTICE, _("PGO: LDFLAGS=%s\n"), new_ldflags);
+
+    free(profdir);
+    free(use_cflags);
+    free(use_ldflags);
+    free(orig_optflags);
+    free(orig_ldflags);
+    free(new_cflags);
+    free(new_ldflags);
+}
+
+/**
+ * Clear PGO environment variable overrides.
+ */
+static void pgoPopEnv(void)
+{
+    unsetenv("CFLAGS");
+    unsetenv("CXXFLAGS");
+    unsetenv("FFLAGS");
+    unsetenv("FCFLAGS");
+    unsetenv("LDFLAGS");
+    unsetenv("RPM_OPT_FLAGS");
+}
+
+/**
+ * Run the PGO profile merge step.
+ * For Clang: llvm-profdata merge *.profraw -o merged.profdata
+ * For GCC: the .gcda files are already in place, no merge needed
+ *          (unless we want to use gcov-tool merge for multiple runs)
+ */
+static rpmRC pgoMergeProfiles(rpmSpec spec, int test, StringBuf *sbp)
+{
+    char *profdir = rpmExpand("%{_pgo_profile_dir}", NULL);
+    int is_clang = pgoIsClang();
+    rpmRC rc = RPMRC_OK;
+
+    if (is_clang) {
+	/* Merge all .profraw files into merged.profdata (PATH llvm-profdata) */
+	char *merge_script = NULL;
+	rasprintf(&merge_script,
+	    "llvm-profdata merge --failure-mode=warn -o '%s/merged.profdata' $(find '%s' -name '*.profraw' -type f)",
+	    profdir, profdir);
+	rc = doScript(spec, RPMBUILD_STRINGBUF, "%pgo-merge",
+		      merge_script, test, sbp);
+	free(merge_script);
+    }
+    /* For GCC, .gcda files are written directly to profdir, no merge needed */
+
+    free(profdir);
+    return rc;
+}
+
+/**
+ * Wipe out-of-tree build dirs only (not extracted sources) for pass 2.
+ *
+ * OMV BuildSystem cmake/meson/autotools put objects under
+ * _OMV_rpm_build{,32}/. Removing those is enough for a clean reconfigure.
+ * Profile data lives in %{_pgo_profile_dir} (sibling of buildsubdir) and
+ * is never removed here.
+ *
+ * If no OMV out-of-tree build dir exists (in-tree packages), fall back to
+ * wiping the full buildsubdir and stamp .pgo-need-reprep so pass 2 re-preps.
+ */
+static rpmRC pgoWipeBuildDir(rpmSpec spec, int test, StringBuf *sbp)
+{
+    char *buildSubdir = rpmGetPath("%{?buildsubdir}", NULL);
+    char *buildDir = rpmGenPath(spec->rootDir, "%{builddir}", "");
+    char *profdir = rpmExpand("%{_pgo_profile_dir}", NULL);
+    rpmRC rc = RPMRC_OK;
+
+    if (buildSubdir[0] != '\0') {
+	char *subpath = NULL;
+	char *wipe_script = NULL;
+	rasprintf(&subpath, "%s/%s", buildDir, buildSubdir);
+	/* Stamp under profdir survives any source wipe. */
+	rasprintf(&wipe_script,
+	    "mkdir -p '%s'\n"
+	    "rm -f '%s/.pgo-need-reprep'\n"
+	    "if [ -d '%s/_OMV_rpm_build' ] || [ -d '%s/_OMV_rpm_build32' ]; then\n"
+	    "  rm -rf '%s/_OMV_rpm_build' '%s/_OMV_rpm_build32'\n"
+	    "else\n"
+	    "  rm -rf '%s'\n"
+	    "  touch '%s/.pgo-need-reprep'\n"
+	    "fi\n",
+	    profdir, profdir,
+	    subpath, subpath,
+	    subpath, subpath,
+	    subpath,
+	    profdir);
+	rpmlog(RPMLOG_NOTICE,
+	    _("PGO: wiping build artifacts under %s for optimized rebuild\n"),
+	    subpath);
+	rc = doScript(spec, RPMBUILD_STRINGBUF, "%pgo-wipe",
+		      wipe_script, test, sbp);
+	free(subpath);
+	free(wipe_script);
+    }
+
+    free(buildSubdir);
+    free(buildDir);
+    free(profdir);
+    return rc;
+}
