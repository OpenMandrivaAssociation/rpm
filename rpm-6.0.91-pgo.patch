+  --define "debug_package %{nil}" \
+  --define "__cc $ccdir/cc" \
+  -bb ${RPMDATA}/SPECS/pgohello.spec 2>&1)
+echo "$out" | grep -F "PGO: using Clang PGO flags"
+echo "$out" | grep -cF -- "-fprofile-correction" || true
+],
+[0],
+[PGO: using Clang PGO flags
+0
+],
+[])
+
+RPMTEST_CLEANUP
+
+# ------------------------------
